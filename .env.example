# Folder Therapy environment configuration
# Copy this file to .env and adjust the values for your local setup.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Folder Therapy"
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Comma-separated or JSON list of allowed CORS origins.
# Example:
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
# Required for AI-powered diagnosis.
OPENAI_API_KEY=sk-replace-me

# Model and generation settings.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1600
OPENAI_TIMEOUT_SECONDS=30

# Optional: point to a compatible OpenAI API endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Scanner defaults
# ---------------------------------------------------------------------------
# Maximum directory depth to scan from the requested root.
SCAN_MAX_DEPTH=6

# Maximum number of files to include in one scan.
SCAN_MAX_FILES=2500

# Include hidden files and folders, such as .config or .git.
SCAN_INCLUDE_HIDDEN=false

# Follow symbolic links while scanning.
SCAN_FOLLOW_SYMLINKS=false

# Directories to ignore during scans.
SCAN_IGNORE_DIRS=[".git",".venv","venv","node_modules","__pycache__",".idea",".vscode",".cache","dist","build"]

# Files to ignore during scans.
SCAN_IGNORE_FILES=[".DS_Store","Thumbs.db","desktop.ini"]

# ---------------------------------------------------------------------------
# Therapy and heuristics
# ---------------------------------------------------------------------------
# Minimum confidence score required to surface a suggestion.
THERAPY_CONFIDENCE_THRESHOLD=0.55

# A project is considered abandoned if it has not changed for this many days.
ABANDONED_PROJECT_DAYS=180

# A folder is considered hoarded if it contains at least this many files.
HOARDING_FILE_COUNT=120

# A folder is considered cluttered if it contains at least this many files.
CLUTTER_FILE_COUNT=80

# Enable content-based duplicate detection when hashing is supported.
ENABLE_DUPLICATE_CHECK=true

# Maximum number of suggestions to include in a report.
REPORT_MAX_SUGGESTIONS=50

# ---------------------------------------------------------------------------
# Reports
# ---------------------------------------------------------------------------
# Directory where generated reports are written.
REPORTS_DIR=reports

# Include supporting evidence in exported reports.
REPORT_INCLUDE_EVIDENCE=true

# ---------------------------------------------------------------------------
# Review queue
# ---------------------------------------------------------------------------
# Automatically apply safe suggestions when a queue is created.
QUEUE_AUTO_APPLY=false

# Maximum number of queue items to apply in one batch.
QUEUE_APPLY_LIMIT=25

# Allow deletion suggestions to be applied from the review queue.
QUEUE_ALLOW_DELETES=true